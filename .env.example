# ── Django Core Settings ──
# DJANGO_SECRET_KEY: Chave secreta de produção. Gere uma chave forte e única (mínimo 50 caracteres).
DJANGO_SECRET_KEY=sua_chave_secreta_aqui_substitua_em_producao

# DJANGO_DEBUG: True apenas em desenvolvimento local. Defina False em produção.
DJANGO_DEBUG=True

# DJANGO_ALLOWED_HOSTS: Lista de domínios ou IPs permitidos separados por vírgula.
# Exemplo para produção: manutencao.freedom.dev.br,localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# DJANGO_CSRF_TRUSTED_ORIGINS: Origens confiáveis para requisições CSRF (separadas por vírgula).
# Exemplo para produção: https://manutencao.freedom.dev.br
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# ── Database Config (Default) ──
# ENGINE: django.db.backends.sqlite3 (desenvolvimento) ou django.db.backends.mysql (produção)
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306

# ── Database Config (Secondary - SCADA LTS) ──
SCADA_DB_ENGINE=django.db.backends.mysql
SCADA_DB_NAME=scadalts
SCADA_DB_USER=seu_usuario_scada
SCADA_DB_PASSWORD=sua_senha_scada
SCADA_DB_HOST=127.0.0.1
SCADA_DB_PORT=3306

# ── Internationalization ──
TIME_ZONE=America/Sao_Paulo
LANGUAGE_CODE=pt-br

# ── Aux Services ──
# WHATSAPP_SERVICE_URL: URL do microserviço Node.js/Baileys para envio de notificações
WHATSAPP_SERVICE_URL=http://localhost:3000/send
