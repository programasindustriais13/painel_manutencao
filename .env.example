# ── Django Core Settings ──
# DJANGO_SECRET_KEY: Chave secreta de produção. Gere uma chave forte e única (mínimo 50 caracteres).
DJANGO_SECRET_KEY=sua_chave_secreta_aqui_substitua_em_producao

# DJANGO_DEBUG: True apenas em desenvolvimento local. Defina False em produção.
DJANGO_DEBUG=True

# DJANGO_ALLOWED_HOSTS: Lista de domínios ou IPs permitidos separados por vírgula.
# Exemplo para produção: manutencao.freedom.dev.br,localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# DJANGO_CSRF_TRUSTED_ORIGINS: Origens confiáveis para requisições CSRF (separadas por vírgula).
# Exemplo para produção: https://manutencao.freedom.dev.br
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# ── Reverse Proxy & Cloudflare Tunnel Settings ──
DJANGO_USE_X_FORWARDED_HOST=True
DJANGO_TRUST_PROXY_SSL_HEADER=True
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# ── Production WSGI Server (Waitress) ──
WAITRESS_HOST=127.0.0.1
WAITRESS_PORT=8900
WAITRESS_THREADS=4

# ── Database Config (Default) ──
# ENGINE: django.db.backends.sqlite3 (desenvolvimento) ou django.db.backends.mysql (produção)
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306

# ── Database Config (Secondary - SCADA LTS) ──
SCADA_DB_ENGINE=django.db.backends.mysql
SCADA_DB_NAME=scadalts
SCADA_DB_USER=scada_monitor_ro
SCADA_DB_PASSWORD=informe_sua_senha_aqui
SCADA_DB_HOST=127.0.0.1
SCADA_DB_PORT=3306
SCADA_DB_CONNECT_TIMEOUT=5
SCADA_COLLECTOR_LOG_FILE=logs/scada_collector.log

# ── Internationalization ──
TIME_ZONE=America/Sao_Paulo
LANGUAGE_CODE=pt-br

# ── Aux Services ──
# WHATSAPP_SERVICE_URL: URL do microserviço Node.js/Baileys para envio de notificações
WHATSAPP_SERVICE_URL=http://127.0.0.1:3000/send

# ── Bladder Tracking & Quality Settings ──
BLADDER_TRACKING_ENABLED=True
BLADDER_REASON_WINDOW_MINUTES=15
BLADDER_SETUP_STABILIZATION_CYCLES=3

# ── AI / Vision OCR Settings (Google Gemini) ──
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-1.5-flash

